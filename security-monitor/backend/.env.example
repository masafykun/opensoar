# ── SOAR backend 設定例 ───────────────────────────────────
# cp .env.example .env して各自の環境に合わせて編集（.env は .gitignore 済）

# 監視対象の表示名・所在地（地図の着弾点）
SOAR_SITE_NAME=My Server
SOAR_PROTECTED_HOST=203.0.113.10          # 例: 自サーバの公開IP（RFC5737のダミー）
SOAR_DEFENDER_LAT=35.68                    # 自サーバ所在地の緯度
SOAR_DEFENDER_LON=139.69                   # 経度
SOAR_DEFENDER_LABEL=保護拠点                # 地図ラベル

# 永続データ（SQLite）の保存先。既定はソース同階層
SOAR_DATA_DIR=

# 監視対象サービス一覧（systemd）。実環境固有なので別ファイルに分離。
# cp services.example.json services.json して編集（services.json は .gitignore 済）。
# 未設定/不在なら nginx/fail2ban/ssh/postgresql の汎用既定で動作。
SOAR_SERVICES_FILE=                         # 既定: backend同階層の services.json

# 地図のデフォルト対象期間（1h / 24h / 7d / 30d / all）
SOAR_DEFAULT_WINDOW=24h

# .zip/.mov 等のTLDドメイン監視（任意機能。未設定でオフ）
SOAR_ZIP_DOMAINS=                           # 例: example.zip,example.mov（カンマ区切り）
SOAR_ZIP_LOG=                               # 例: /var/log/nginx/zip-domains_access.log

# CORS 許可オリジン（カンマ区切り。同一オリジン構成では通常不要）
SOAR_CORS_ORIGINS=http://localhost:3002

# ── AIチャット（任意。未設定ならチャットは無効化される）──
OPENAI_API_KEY=
SOAR_CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1  # Ollama/Azure/vLLM等に差し替え可

# ── GeoIP（任意。既定 ip-api.com=無料・非商用・平文HTTP・45req/分）──
# GEOIP_BATCH_URL=http://ip-api.com/batch

# ── リモートログ連携（任意。pull_remote.sh と同じ値を共有）──
SOAR_REMOTE_DIR=/var/log/soar-remote
SOAR_REMOTE_ENVS=                          # 例: staging,edge（カンマ区切り。空で無効）
SOAR_DOMAIN_SUFFIX=                         # 例: .example.com（サイト名から剥がす接尾辞）

# ── アプリ内蔵のメールOTP/JWT認証（任意。既定OFF＝前段のnginx Basic認証等に委ねる）──
SOAR_REQUIRE_AUTH=false                     # true で /api/* をログイン必須にする
SOAR_COOKIE_SECURE=true                     # https配信なら true
SOAR_ADMIN_EMAIL=                           # 起動時に admin として seed するメール
JWT_SECRET=                                # 認証ONなら必須: openssl rand -hex 32 で生成
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OTP_EMAIL=                                 # OTP送信先

# ── メール通知（notify.py / cron で重大アラートをダイジェスト送信）──
SOAR_ALERT_EMAIL=                          # 通知先（未設定なら SOAR_ADMIN_EMAIL → OTP_EMAIL）
SOAR_ALERT_SEVERITIES=Critical             # 通知する重大度。既定=Critical のみ。High も欲しければ Critical,High
